{
  "name": "@tpvpn/site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TP VPN Design System documentation & demo site (Vite + React 19 + Tailwind 4)",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "vite --port 5180",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview --port 5181",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync-assets": "node scripts/sync-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.2.0",
    "@tpvpn/tokens": "workspace:*",
    "@tpvpn/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.38.0",
    "motion": "^12.23.0",
    "radix-ui": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "shiki": "^3.12.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
