{
  "duration": {
    "$type": "duration",
    "instant": { "$value": "0ms" },
    "fast": { "$value": "100ms", "$description": "Hover/press feedback" },
    "quick": { "$value": "150ms", "$description": "Reduced-motion fallback fade" },
    "base": { "$value": "200ms", "$description": "Default UI transitions" },
    "moderate": { "$value": "300ms", "$description": "Sheets, dialogs, page reveals" },
    "slow": { "$value": "500ms", "$description": "Hero reveals" },
    "slower": { "$value": "800ms", "$description": "Decorative" },
    "connect": { "$value": "1200ms", "$description": "Connection ring breathing loop" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1], "$description": "Default in-app transitions" },
    "emphasized": { "$value": [0.16, 1, 0.3, 1], "$description": "Reveals, hero motion" },
    "decelerate": { "$value": [0, 0, 0.2, 1], "$description": "Entering elements" },
    "accelerate": { "$value": [0.4, 0, 1, 1], "$description": "Exiting elements" },
    "spring": { "$value": [0.34, 1.56, 0.64, 1], "$description": "Playful overshoot (connection success)" }
  }
}
